{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ember",
  "scopeName": "source.ember",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string_double" },
    { "include": "#string_single" },
    { "include": "#float" },
    { "include": "#integer" },
    { "include": "#constant_language" },
    { "include": "#keyword_control" },
    { "include": "#support_function" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ember",
          "match": "#.*$"
        }
      ]
    },
    "string_double": {
      "name": "string.quoted.double.ember",
      "begin": "\"",
      "end": "\"|(?=\\n)|(?=\\r)",
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "string_single": {
      "name": "string.quoted.single.ember",
      "begin": "'",
      "end": "'|(?=\\n)|(?=\\r)",
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "escape": {
      "name": "constant.character.escape.ember",
      "match": "\\\\[ntr\\\\\"'0]"
    },
    "float": {
      "name": "constant.numeric.float.ember",
      "match": "\\b(?!\\.)\\d[\\d_]*(?:\\.[\\d_]+)?[eE][+-]?\\d[\\d_]*\\b|\\b\\d[\\d_]*\\.[\\d_]+\\b"
    },
    "integer": {
      "name": "constant.numeric.integer.ember",
      "match": "\\b\\d[\\d_]*\\b(?![eE][+-]?\\d)"
    },
    "constant_language": {
      "name": "constant.language.ember",
      "match": "\\b(true|false|null)\\b"
    },
    "keyword_control": {
      "name": "keyword.control.ember",
      "match": "\\b(let|fn|if|elif|else|while|for|in|return|break|continue|and|or|not)\\b"
    },
    "support_function": {
      "name": "support.function.ember",
      "match": "\\b(len|print|write|push|pop|keys|values|get|has|str|int|float|type|range|upper|lower|trim|split|join|chars|replace|contains|abs|floor|ceil|round|min|max|ask)\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.ember",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.comparison.ember",
          "match": "==|!=|<=|>=|=|<|>"
        },
        {
          "name": "keyword.operator.range.ember",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.ember",
          "match": "[-+*/%]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.ember",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.ember",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.parameters.begin.ember",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.parameters.end.ember",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.ember",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.ember",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.ember",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.ember",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.ember",
          "match": "\\."
        }
      ]
    }
  }
}
